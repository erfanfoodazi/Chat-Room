@page "/login"
@using Microsoft.AspNetCore.Identity
@using Domain.Entities
@inject SignInManager<User> SignInManager
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-dark">
    <div class="card border-secondary shadow-lg" style="width: 100%; max-width: 460px;">
        <div class="card-body p-4 p-md-5 bg-dark text-white rounded">

            <span class="badge bg-primary bg-opacity-25 text-primary mb-3">Welcome Back</span>
            <h2 class="fw-bold mb-1">Sign In</h2>
            <p class="text-secondary mb-4">Log in to continue to ChatRoom.</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2">⚠ @errorMessage</div>
            }

            <div class="mb-3">
                <label class="form-label text-secondary small text-uppercase fw-semibold">Username or Email</label>
                <input type="text" class="form-control bg-black border-secondary text-white"
                       @bind="usernameOrEmail" placeholder="john@example.com" />
            </div>

            <div class="mb-4">
                <label class="form-label text-secondary small text-uppercase fw-semibold">Password</label>
                <input type="password" class="form-control bg-black border-secondary text-white"
                       @bind="password" placeholder="Enter your password" />
            </div>

            <button class="btn btn-primary w-100 py-2 fw-semibold"
                    @onclick="HandleLogin" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Sign In →</span>
                }
            </button>

            <p class="text-center text-secondary mt-3 mb-0 small">
                Don't have an account?
                <a href="/register" class="text-primary text-decoration-none fw-semibold">Create one</a>
            </p>

        </div>
    </div>
</div>

@code {
    private string usernameOrEmail = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(usernameOrEmail) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Username and password are required.";
            return;
        }

        isLoading = true;

        try
        {
            // SignInManager requires the username, so if the user typed an email we look it up first
            var user = await SignInManager.UserManager.FindByEmailAsync(usernameOrEmail);
            var username = user?.UserName ?? usernameOrEmail;

            var result = await SignInManager.PasswordSignInAsync(
                username, password, isPersistent: true, lockoutOnFailure: true);

            if (result.Succeeded)
            {
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else if (result.IsLockedOut)
            {
                errorMessage = "Account is locked. Try again later.";
            }
            else if (result.RequiresTwoFactor)
            {
                errorMessage = "Two-factor authentication is required.";
            }
            else
            {
                errorMessage = "Invalid username or password.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
