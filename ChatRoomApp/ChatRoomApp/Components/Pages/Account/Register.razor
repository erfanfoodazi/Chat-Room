@page "/account/register"
@rendermode InteractiveServer
@layout NoLayout
@using MediatR
@using Application.Users.UseCases.Commands
@inject IMediator Mediator
@inject NavigationManager Navigation


<div class="min-vh-100 d-flex align-items-center justify-content-center bg-dark">
    <div class="card border-secondary shadow-lg" style="width: 100%; max-width: 460px;">
        <div class="card-body p-4 p-md-5 bg-dark text-white rounded">

            <span class="badge bg-primary bg-opacity-25 text-primary mb-3">New Account</span>
            <h2 class="fw-bold mb-1">Join ChatRoom</h2>
            <p class="text-secondary mb-4">Create your account and start chatting.</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2">⚠ @errorMessage</div>
            }

            @if (isSuccess)
            {
                <div class="alert alert-success py-2">✓ Account created! Redirecting...</div>
            }

            <div class="mb-3">
                <label class="form-label text-secondary small text-uppercase fw-semibold">Full Name</label>
                <input type="text" class="form-control bg-black border-secondary text-white"
                       @bind="fullName" placeholder="John Doe" />
            </div>

            <div class="mb-3">
                <label class="form-label text-secondary small text-uppercase fw-semibold">Username</label>
                <input type="text" class="form-control bg-black border-secondary text-white"
                       @bind="userName" placeholder="johndoe" />
            </div>

            <div class="mb-3">
                <label class="form-label text-secondary small text-uppercase fw-semibold">Email</label>
                <input type="email" class="form-control bg-black border-secondary text-white"
                       @bind="email" placeholder="john@example.com" />
            </div>

            <div class="mb-3">
                <label class="form-label text-secondary small text-uppercase fw-semibold">Password</label>
                <input type="password" class="form-control bg-black border-secondary text-white"
                       @bind="password" placeholder="Min. 6 characters" />
            </div>

            <div class="mb-4">
                <label class="form-label text-secondary small text-uppercase fw-semibold">Confirm Password</label>
                <input type="password" class="form-control bg-black border-secondary text-white"
                       @bind="confirmPassword" placeholder="Repeat password" />
            </div>

            <button class="btn btn-primary w-100 py-2 fw-semibold"
                    @onclick="HandleRegister" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Creating account...</span>
                }
                else
                {
                    <span>Create Account →</span>
                }
            </button>

            <p class="text-center text-secondary mt-3 mb-0 small">
                Already have an account?
                <a href="/account/login" class="text-primary text-decoration-none fw-semibold">Sign in</a>
            </p>

        </div>
    </div>
</div>

@code {
    private string fullName = string.Empty;
    private string userName = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string confirmPassword = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool isSuccess = false;

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(fullName) ||
            string.IsNullOrWhiteSpace(userName) ||
            string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "All fields are required.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        if (password.Length < 6)
        {
            errorMessage = "Password must be at least 6 characters.";
            return;
        }

        isLoading = true;

        try
        {
            await Mediator.Send(new AddNewUserCommand
            {
                FullName = fullName,
                UserName = userName,
                Email = email,
                Password = password,
            });

            isSuccess = true;
            await Task.Delay(1500);
            Navigation.NavigateTo("/account/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}