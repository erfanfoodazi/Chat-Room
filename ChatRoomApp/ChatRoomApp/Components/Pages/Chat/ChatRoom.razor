@page "/chat/personal/{ChatId:int}"
@page "/chat/group/{ChatId:int}"
@rendermode InteractiveServer
@using Application.PersonalChats.UseCases.Queries
@using Application.PersonalChats.UseCases.Commands
@using Application.GroupChats.UseCases.Queries
@using Application.GroupChats.UseCases.Commands
@using Application.Messages.UseCases.Commands
@using Application.Messages.UseCases.Dto
@using Application.Users.UseCases.Queries
@using Application.Users.UseCases.DTOs
@using ChatRoomApp.Services
@using Domain.Entities
@using MediatR
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR
@using Microsoft.JSInterop
@implements IDisposable
@inject IMediator Mediator
@inject IHubContext<Hubs.ChatHub> HubContext
@inject MessageBroadcastService BroadcastService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject UserStatusBroadcastService StatusBroadcast

<div class="chat-room d-flex flex-column">
    <div class="chat-header d-flex align-items-center gap-3 px-4 py-3">
        <button class="btn-back" @onclick="GoBack" type="button" title="Back">
            <i class="fas fa-arrow-left"></i>
        </button>
        <div class="chat-header-info flex-grow-1">
            <h5 class="m-0">@chatName</h5>
            <small class="text-secondary">@statusText</small>
        </div>
        @if (isGroupChat)
        {
            @if (currentUserRole is GroupRole.Owner or GroupRole.Admin)
            {
                <button class="btn btn-sm btn-outline-light" @onclick="ShowAddMemberModal" title="Add Member">
                    <i class="fas fa-user-plus"></i>
                </button>
            }
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-light" @onclick="ToggleSettingsMenu" type="button">
                    <i class="fas fa-cog"></i>
                </button>
                @if (showSettingsMenu)
                {
                    <div class="dropdown-backdrop" @onclick="CloseSettingsMenu"></div>
                    <div class="settings-menu">
                        @if (currentUserRole is GroupRole.Owner or GroupRole.Admin)
                        {
                            <button class="settings-item" @onclick="ShowEditGroupNameModal"><i class="fas fa-pen me-2"></i>Edit Group Name</button>
                        }
                        @if (currentUserRole is GroupRole.Owner)
                        {
                            <button class="settings-item text-danger" @onclick="ShowDeleteGroupConfirm"><i class="fas fa-trash me-2"></i>Delete Group</button>
                        }
                        <button class="settings-item text-warning" @onclick="ShowLeaveGroupConfirm"><i class="fas fa-sign-out-alt me-2"></i>Leave Group</button>
                    </div>
                }
            </div>
        }
    </div>

    <div class="messages-area flex-grow-1 px-4 py-3" @ref="messagesContainer">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (!messages.Any())
        {
            <div class="empty-state text-center py-5">
                <i class="fas fa-comment-slash fa-3x text-secondary mb-3"></i>
                <p class="text-secondary">No messages yet. Say hello!</p>
            </div>
        }
        else
        {
            @foreach (var msg in messages)
            {
                var isMine = msg.SenderId == currentUserId;
                <div class="message @(isMine ? "mine" : "theirs")">
                    @if (!isMine)
                    {
                        <div class="sender-row">
                            @if (!string.IsNullOrEmpty(msg.SenderProfilePictureUrl))
                            {
                                <img class="sender-avatar" src="@msg.SenderProfilePictureUrl" alt="" />
                            }
                            else
                            {
                                <span class="sender-avatar-letter">@(msg.SenderName.Length > 0 ? msg.SenderName[0].ToString().ToUpper() : "?")</span>
                            }
                            @if (isGroupChat)
                            {
                                <small class="sender-name">@msg.SenderName</small>
                            }
                        </div>
                    }
                    <div class="bubble @(isMine ? "bubble-mine" : "bubble-theirs")">
                        @if (msg.ReplyToMessageId.HasValue)
                        {
                            <div class="reply-preview">
                                <div class="reply-sender">@(msg.ReplyToSenderName ?? "Unknown")</div>
                                <div class="reply-text">@(msg.ReplyToMessageText ?? "[deleted]")</div>
                            </div>
                        }
                        @if (msg.IsDeleted)
                        {
                            <div class="msg-text deleted-msg"><em>This message was deleted</em></div>
                        }
                        else
                        {
                            @if (editingMessageId == msg.Id)
                            {
                                <textarea class="form-control edit-msg-input" @bind="editingMessageText" @bind:event="oninput"></textarea>
                                <div class="edit-actions mt-1">
                                    <button class="btn btn-sm btn-success me-1" @onclick="() => SaveEdit(msg.Id)"><i class="fas fa-check"></i></button>
                                    <button class="btn btn-sm btn-secondary" @onclick="CancelEdit"><i class="fas fa-times"></i></button>
                                </div>
                            }
                            else
                            {
                                <div class="msg-text">@msg.Text</div>
                            }
                        }
                        <div class="msg-meta d-flex align-items-center justify-content-end gap-1">
                            @if (msg.IsEdited && !msg.IsDeleted)
                            {
                                <span class="edited-badge">(edited)</span>
                            }
                            <span class="msg-time">@msg.SentTime.ToLocalTime().ToShortTimeString()</span>
                            @if (isMine && !msg.IsDeleted)
                            {
                                @if (msg.IsSeen)
                                {
                                    <i class="fas fa-check-double text-info" style="font-size:0.65rem"></i>
                                }
                                else if (msg.IsDelivered)
                                {
                                    <i class="fas fa-check-double text-secondary" style="font-size:0.65rem"></i>
                                }
                                else
                                {
                                    <i class="fas fa-check text-secondary" style="font-size:0.65rem"></i>
                                }
                            }
                            @if (!msg.IsDeleted && editingMessageId != msg.Id)
                            {
                                <div class="msg-dropdown" @onclick="() => ToggleMessageMenu(msg.Id)" tabindex="0">
                                    <button class="btn btn-sm btn-link text-white p-0 ms-1" type="button" style="font-size:0.65rem;line-height:1;text-decoration:none;opacity:0.6">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    @if (showMessageMenuForId == msg.Id)
                                    {
                                        <div class="msg-menu">
                                            <button class="msg-menu-item" @onclick="() => StartReply(msg)" @onclick:stopPropagation="true"><i class="fas fa-reply me-2"></i>Reply</button>
                                            @if (isMine)
                                            {
                                                <button class="msg-menu-item" @onclick="() => StartEdit(msg.Id, msg.Text)" @onclick:stopPropagation="true"><i class="fas fa-pen me-2"></i>Edit</button>
                                                <button class="msg-menu-item text-danger" @onclick="() => ConfirmDelete(msg.Id)" @onclick:stopPropagation="true"><i class="fas fa-trash me-2"></i>Delete</button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @if (replyToMessageId.HasValue)
    {
        <div class="reply-bar">
            <div class="reply-bar-content">
                <i class="fas fa-reply reply-bar-icon"></i>
                <div class="reply-bar-info">
                    <span class="reply-bar-sender">@replyToSenderName</span>
                    <span class="reply-bar-text">@replyToMessageText</span>
                </div>
            </div>
            <button class="reply-bar-close" @onclick="CancelReply" title="Cancel reply">&times;</button>
        </div>
    }
    <div class="message-input d-flex align-items-center gap-3 px-4 py-3">
        <textarea class="form-control"
                  rows="1"
                  placeholder="Type a message..."
                  @bind="messageText"
                  @bind:event="oninput"
                  @onkeydown="HandleKeyDown"
                  disabled="@isLoading" />
        <button class="btn btn-primary send-btn"
                @onclick="SendMessage"
                disabled="@(string.IsNullOrWhiteSpace(messageText) || isSending)">
            <i class="fas fa-paper-plane"></i>
        </button>
    </div>
</div>

@if (showAddMemberModal)
{
    <div class="grp-modal-overlay" @onclick="CloseAddMemberModal">
        <div class="grp-modal-box" @onclick:stopPropagation="true">
            <div class="grp-modal-head">
                <h5 class="grp-modal-title"><i class="fas fa-user-plus me-2"></i>Add Member</h5>
                <button type="button" class="btn-close" @onclick="CloseAddMemberModal">×</button>
            </div>
            <div class="grp-modal-body">
                <div class="mb-3">
                    <label for="memberSearch" class="form-label">Search by username or email</label>
                    <div class="input-group">
                        <input id="memberSearch" type="text" class="form-control"
                               placeholder="Type to search..."
                               @bind="memberSearchQuery" @bind:event="oninput" />
                        <button class="btn btn-primary" @onclick="SearchMember"
                                disabled="@(string.IsNullOrWhiteSpace(memberSearchQuery) || isSearchingMember)">
                            @if (isSearchingMember)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <i class="fas fa-search"></i>
                            }
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(memberSearchError))
                {
                    <div class="alert alert-danger py-2">@memberSearchError</div>
                }

                @if (foundMember is not null)
                {
                    <div class="user-card">
                        <div class="user-avatar">@(foundMember.FullName.Length > 0 ? foundMember.FullName[0].ToString().ToUpper() : "?")</div>
                        <div class="user-info">
                            <strong>@foundMember.FullName</strong>
                            <small class="text-secondary">@@@foundMember.UserName</small>
                        </div>
                        @if (isAddingMember)
                        {
                            <span class="spinner-border spinner-border-sm text-success"></span>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => AddMember(foundMember.Id)">
                                <i class="fas fa-plus"></i> Add
                            </button>
                        }
                    </div>
                }

                @if (hasSearchedMember && foundMember is null && string.IsNullOrEmpty(memberSearchError))
                {
                    <div class="empty-state text-center py-3">
                        <i class="fas fa-user-slash fa-2x text-secondary mb-2"></i>
                        <p class="text-secondary mb-0">No user found.</p>
                    </div>
                }

                @if (memberAddedMessage != null)
                {
                    <div class="alert alert-@(memberAddedMessage.IsSuccess ? "success" : "danger") py-2 mt-2">
                        @memberAddedMessage.Text
                    </div>
                }
            </div>
            <div class="grp-modal-foot">
                <button type="button" class="btn btn-secondary" @onclick="CloseAddMemberModal">Close</button>
            </div>
        </div>
    </div>
}

@if (showEditGroupNameModal)
{
    <div class="grp-modal-overlay" @onclick="CloseEditGroupNameModal">
        <div class="grp-modal-box" @onclick:stopPropagation="true">
            <div class="grp-modal-head">
                <h5 class="grp-modal-title"><i class="fas fa-pen me-2"></i>Edit Group Name</h5>
                <button type="button" class="btn-close" @onclick="CloseEditGroupNameModal">×</button>
            </div>
            <div class="grp-modal-body">
                <div class="mb-3">
                    <label for="groupNameInput" class="form-label">Group Name</label>
                    <input id="groupNameInput" type="text" class="form-control" @bind="editGroupNameText" />
                </div>
                @if (!string.IsNullOrEmpty(editGroupNameError))
                {
                    <div class="alert alert-danger py-2">@editGroupNameError</div>
                }
            </div>
            <div class="grp-modal-foot">
                <button type="button" class="btn btn-secondary me-2" @onclick="CloseEditGroupNameModal">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="SaveGroupName" disabled="@(string.IsNullOrWhiteSpace(editGroupNameText) || isSavingGroupName)">
                    @if (isSavingGroupName)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="fas fa-save me-1"></i>
                    }
                    Save
                </button>
            </div>
        </div>
    </div>
}

@if (showLeaveGroupConfirm)
{
    <div class="grp-modal-overlay" @onclick="CloseLeaveGroupConfirm">
        <div class="grp-modal-box" @onclick:stopPropagation="true">
            <div class="grp-modal-head">
                <h5 class="grp-modal-title text-warning"><i class="fas fa-sign-out-alt me-2"></i>Leave Group</h5>
                <button type="button" class="btn-close" @onclick="CloseLeaveGroupConfirm">×</button>
            </div>
            <div class="grp-modal-body">
                <p>Are you sure you want to leave <strong>@chatName</strong>?</p>
                @if (!string.IsNullOrEmpty(leaveGroupError))
                {
                    <div class="alert alert-danger py-2">@leaveGroupError</div>
                }
            </div>
            <div class="grp-modal-foot">
                <button type="button" class="btn btn-secondary me-2" @onclick="CloseLeaveGroupConfirm">Cancel</button>
                <button type="button" class="btn btn-warning" @onclick="LeaveGroup" disabled="@isLeavingGroup">
                    @if (isLeavingGroup)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    Leave
                </button>
            </div>
        </div>
    </div>
}

@if (showDeleteGroupConfirm)
{
    <div class="grp-modal-overlay" @onclick="CloseDeleteGroupConfirm">
        <div class="grp-modal-box" @onclick:stopPropagation="true">
            <div class="grp-modal-head">
                <h5 class="grp-modal-title text-danger"><i class="fas fa-trash me-2"></i>Delete Group</h5>
                <button type="button" class="btn-close" @onclick="CloseDeleteGroupConfirm">×</button>
            </div>
            <div class="grp-modal-body">
                <p>Are you sure you want to delete <strong>@chatName</strong>? This action cannot be undone.</p>
                @if (!string.IsNullOrEmpty(deleteGroupError))
                {
                    <div class="alert alert-danger py-2">@deleteGroupError</div>
                }
            </div>
            <div class="grp-modal-foot">
                <button type="button" class="btn btn-secondary me-2" @onclick="CloseDeleteGroupConfirm">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="DeleteGroup" disabled="@isDeletingGroup">
                    @if (isDeletingGroup)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int ChatId { get; set; }

    private List<MessageDto> messages = new();
    private string messageText = string.Empty;
    private string chatName = "Loading...";
    private string statusText = string.Empty;
    private bool isLoading = true;
    private bool isSending;
    private bool isGroupChat;
    private int currentUserId;
    private int otherUserId;
    private Dictionary<int, string> senderNames = new();
    private GroupRole? currentUserRole;
    private ElementReference messagesContainer;

    private int? replyToMessageId;
    private string? replyToMessageText;
    private string? replyToSenderName;

    private bool showAddMemberModal;
    private string memberSearchQuery = string.Empty;
    private bool isSearchingMember;
    private bool hasSearchedMember;
    private string memberSearchError = string.Empty;
    private UserDto? foundMember;
    private bool isAddingMember;
    private MemberAddedMessage? memberAddedMessage;

    private bool showEditGroupNameModal;
    private string editGroupNameText = string.Empty;
    private string editGroupNameError = string.Empty;
    private bool isSavingGroupName;

    private bool showLeaveGroupConfirm;
    private string leaveGroupError = string.Empty;
    private bool isLeavingGroup;

    private bool showDeleteGroupConfirm;
    private string deleteGroupError = string.Empty;
    private bool isDeletingGroup;

    private int? editingMessageId;
    private string editingMessageText = string.Empty;
    private bool showSettingsMenu;
    private int? showMessageMenuForId;

    private class MemberAddedMessage
    {
        public string Text { get; set; } = string.Empty;
        public bool IsSuccess { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await GetCurrentUserId();
        if (currentUserId == 0) { Navigation.NavigateTo("/account/login"); return; }

        var uri = new Uri(Navigation.Uri);
        isGroupChat = uri.AbsolutePath.StartsWith("/chat/group", StringComparison.OrdinalIgnoreCase);

        BroadcastService.OnPersonalMessageReceived += HandlePersonalMessage;
        BroadcastService.OnGroupMessageReceived += HandleGroupMessage;
        BroadcastService.OnMessageEdited += HandleMessageEdited;
        BroadcastService.OnMessageDeleted += HandleMessageDeleted;
        StatusBroadcast.OnUserStatusChanged += HandleUserStatusChanged;

        await LoadChat();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await ScrollToBottom();
    }

    private async Task GetCurrentUserId()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            currentUserId = userId;
        }
    }

    private async Task LoadChat()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (isGroupChat)
            {
                var group = await Mediator.Send(new GetGroupChatByIdQuery { GroupId = ChatId });
                if (group is null) { Navigation.NavigateTo("/chat"); return; }

                chatName = group.Name;
                statusText = $"{group.Members.Count} members";
                messages = group.Messages.OrderBy(m => m.SentTime).ToList();

                foreach (var member in group.Members)
                {
                    if (member.UserId == currentUserId)
                        currentUserRole = member.Role;
                }

                foreach (var member in group.Members)
                {
                    var user = await Mediator.Send(new GetUserByIdQuery { UserId = member.UserId });
                    if (user != null)
                        senderNames[member.UserId] = user.FullName ?? user.UserName ?? "Unknown";
                }
            }
            else
            {
                var chat = await Mediator.Send(new GetPersonalChatByIdQuery { PersonalId = ChatId });
                if (chat is null) { Navigation.NavigateTo("/chat"); return; }

                otherUserId = chat.UserOneId == currentUserId ? chat.UserTwoId : chat.UserOneId;
                var user = await Mediator.Send(new GetUserByIdQuery { UserId = otherUserId });
                chatName = user?.FullName ?? user?.UserName ?? "Unknown";
                statusText = user?.IsOnline == true ? "Online" : "Offline";
                messages = chat.Messages.OrderBy(m => m.SentTime).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading chat: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(messageText) || isSending) return;

        var text = messageText;
        messageText = string.Empty;
        var replyId = replyToMessageId;
        replyToMessageId = null;
        replyToMessageText = null;
        replyToSenderName = null;
        isSending = true;
        StateHasChanged();

        try
        {
            if (isGroupChat)
            {
                var msg = await Mediator.Send(new SendMessageToGroupCommand
                {
                    GroupId = ChatId,
                    SenderId = currentUserId,
                    Text = text,
                    ReplyToMessageId = replyId,
                });

                if (msg != null)
                {
                    messages.Add(msg);
                    await HubContext.Clients.Group(ChatId.ToString())
                        .SendAsync("ReceiveGroupMessage", msg);
                    BroadcastService.NotifyGroupMessage(msg);
                    StateHasChanged();
                }
            }
            else
            {
                var msg = await Mediator.Send(new SendPersonalMessageCommand
                {
                    SenderId = currentUserId,
                    ReceiverId = otherUserId,
                    PersonalChatId = ChatId,
                    Text = text,
                    ReplyToMessageId = replyId,
                });

                if (msg != null)
                {
                    messages.Add(msg);
                    await HubContext.Clients.User(otherUserId.ToString())
                        .SendAsync("ReceivePersonalMessage", msg);
                    BroadcastService.NotifyPersonalMessage(msg);
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Send failed: {ex.Message}");
        }
        finally
        {
            isSending = false;
        }
    }

    private void HandlePersonalMessage(MessageDto msg)
    {
        if (!isGroupChat && msg.PersonalChatId == ChatId && msg.SenderId != currentUserId)
        {
            messages.Add(msg);
            InvokeAsync(StateHasChanged);
            InvokeAsync(ScrollToBottom);
        }
    }

    private void HandleGroupMessage(MessageDto msg)
    {
        if (isGroupChat && msg.GroupChatId == ChatId && msg.SenderId != currentUserId)
        {
            if (!senderNames.ContainsKey(msg.SenderId))
            {
                _ = LoadSenderNameAsync(msg.SenderId);
            }
            messages.Add(msg);
            InvokeAsync(StateHasChanged);
            InvokeAsync(ScrollToBottom);
        }
    }

    private void HandleUserStatusChanged(int userId, bool isOnline)
    {
        if (!isGroupChat && userId == otherUserId)
        {
            statusText = isOnline ? "Online" : "Offline";
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadSenderNameAsync(int userId)
    {
        try
        {
            var user = await Mediator.Send(new GetUserByIdQuery { UserId = userId });
            if (user != null)
            {
                senderNames[userId] = user.FullName ?? user.UserName ?? "Unknown";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    private void HandleMessageEdited(MessageDto msg)
    {
        var idx = messages.FindIndex(m => m.Id == msg.Id);
        if (idx >= 0)
        {
            messages[idx] = msg;
            InvokeAsync(StateHasChanged);
        }
    }

    private void HandleMessageDeleted(int messageId, int? groupChatId, int? personalChatId)
    {
        if (isGroupChat && groupChatId == ChatId)
        {
            var idx = messages.FindIndex(m => m.Id == messageId);
            if (idx >= 0)
            {
                messages[idx].IsDeleted = true;
                messages[idx].Text = "This message was deleted";
                InvokeAsync(StateHasChanged);
            }
        }
        else if (!isGroupChat && personalChatId == ChatId)
        {
            var idx = messages.FindIndex(m => m.Id == messageId);
            if (idx >= 0)
            {
                messages[idx].IsDeleted = true;
                messages[idx].Text = "This message was deleted";
                InvokeAsync(StateHasChanged);
            }
        }
    }

    // ─── Message Edit / Delete ────────────────────────────────
    private void StartEdit(int messageId, string text)
    {
        showMessageMenuForId = null;
        editingMessageId = messageId;
        editingMessageText = text;
    }

    private void CancelEdit()
    {
        editingMessageId = null;
        editingMessageText = string.Empty;
    }

    private async Task SaveEdit(int messageId)
    {
        if (string.IsNullOrWhiteSpace(editingMessageText)) return;

        var msg = await Mediator.Send(new UpdateMessageCommand
        {
            MessageId = messageId,
            Text = editingMessageText,
            SenderId = currentUserId,
        });

        if (msg != null)
        {
            var idx = messages.FindIndex(m => m.Id == messageId);
            if (idx >= 0)
                messages[idx] = msg;

            if (msg.GroupChatId.HasValue)
            {
                await HubContext.Clients.Group(msg.GroupChatId.Value.ToString())
                    .SendAsync("MessageEdited", msg);
            }
            BroadcastService.NotifyMessageEdited(msg);
        }

        CancelEdit();
    }

    private async Task ConfirmDelete(int messageId)
    {
        var msg = messages.FirstOrDefault(m => m.Id == messageId);
        if (msg == null) return;

        var success = await Mediator.Send(new DeleteMessageCommand
        {
            MessageId = messageId,
            SenderId = currentUserId,
        });

        if (success)
        {
            msg.IsDeleted = true;
            msg.Text = "This message was deleted";

            if (msg.GroupChatId.HasValue)
            {
                await HubContext.Clients.Group(msg.GroupChatId.Value.ToString())
                    .SendAsync("MessageDeleted", messageId, msg.GroupChatId);
            }
            BroadcastService.NotifyMessageDeleted(messageId, msg.GroupChatId, msg.PersonalChatId);
            StateHasChanged();
        }
    }

    // ─── Edit Group Name ──────────────────────────────────────
    private void ShowEditGroupNameModal()
    {
        showSettingsMenu = false;
        editGroupNameText = chatName;
        editGroupNameError = string.Empty;
        isSavingGroupName = false;
        showEditGroupNameModal = true;
    }

    private void CloseEditGroupNameModal()
    {
        showEditGroupNameModal = false;
    }

    private async Task SaveGroupName()
    {
        if (string.IsNullOrWhiteSpace(editGroupNameText) || isSavingGroupName) return;
        isSavingGroupName = true;
        editGroupNameError = string.Empty;
        StateHasChanged();

        try
        {
            var success = await Mediator.Send(new UpdateGroupChatCommand
            {
                GroupId = ChatId,
                Name = editGroupNameText,
                RequestedByUserId = currentUserId,
            });

            if (success)
            {
                chatName = editGroupNameText;
                showEditGroupNameModal = false;
            }
            else
            {
                editGroupNameError = "You don't have permission to edit the group name.";
            }
        }
        catch (Exception ex)
        {
            editGroupNameError = $"Error: {ex.Message}";
        }
        finally
        {
            isSavingGroupName = false;
            StateHasChanged();
        }
    }

    // ─── Leave Group ──────────────────────────────────────────
    private void ShowLeaveGroupConfirm()
    {
        showSettingsMenu = false;
        leaveGroupError = string.Empty;
        isLeavingGroup = false;
        showLeaveGroupConfirm = true;
    }

    private void CloseLeaveGroupConfirm()
    {
        showLeaveGroupConfirm = false;
    }

    private async Task LeaveGroup()
    {
        if (isLeavingGroup) return;
        isLeavingGroup = true;
        leaveGroupError = string.Empty;
        StateHasChanged();

        try
        {
            var success = await Mediator.Send(new LeaveGroupCommand
            {
                GroupId = ChatId,
                UserId = currentUserId,
            });

            if (success)
            {
                await HubContext.Clients.Group(ChatId.ToString())
                    .SendAsync("UserLeftGroup", currentUserId, ChatId);
                Navigation.NavigateTo("/chat/group");
            }
            else
            {
                leaveGroupError = "Failed to leave the group.";
            }
        }
        catch (Exception ex)
        {
            leaveGroupError = $"Error: {ex.Message}";
        }
        finally
        {
            isLeavingGroup = false;
            StateHasChanged();
        }
    }

    // ─── Delete Group ─────────────────────────────────────────
    private void ShowDeleteGroupConfirm()
    {
        showSettingsMenu = false;
        deleteGroupError = string.Empty;
        isDeletingGroup = false;
        showDeleteGroupConfirm = true;
    }

    private void CloseDeleteGroupConfirm()
    {
        showDeleteGroupConfirm = false;
    }

    private async Task DeleteGroup()
    {
        if (isDeletingGroup) return;
        isDeletingGroup = true;
        deleteGroupError = string.Empty;
        StateHasChanged();

        try
        {
            var success = await Mediator.Send(new DeleteGroupChatCommand
            {
                GroupId = ChatId,
                RequestedByUserId = currentUserId,
            });

            if (success)
            {
                Navigation.NavigateTo("/chat/group");
            }
            else
            {
                deleteGroupError = "Only the owner can delete the group.";
            }
        }
        catch (Exception ex)
        {
            deleteGroupError = $"Error: {ex.Message}";
        }
        finally
        {
            isDeletingGroup = false;
            StateHasChanged();
        }
    }

    private string GetSenderName(int userId)
    {
        return senderNames.TryGetValue(userId, out var name) ? name : "Unknown";
    }

    private void ToggleSettingsMenu()
    {
        showSettingsMenu = !showSettingsMenu;
    }

    private void CloseSettingsMenu()
    {
        showSettingsMenu = false;
    }

    private void ToggleMessageMenu(int messageId)
    {
        showMessageMenuForId = showMessageMenuForId == messageId ? null : messageId;
    }

    private void CloseMessageMenu()
    {
        showMessageMenuForId = null;
    }

    private void StartReply(MessageDto msg)
    {
        replyToMessageId = msg.Id;
        replyToMessageText = msg.Text;
        replyToSenderName = msg.SenderName;
        showMessageMenuForId = null;
        StateHasChanged();
    }

    private void CancelReply()
    {
        replyToMessageId = null;
        replyToMessageText = null;
        replyToSenderName = null;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "document.querySelector('.messages-area')?.scrollTo(0, document.querySelector('.messages-area')?.scrollHeight)");
        }
        catch { }
    }

    private void GoBack()
    {
        if (isGroupChat)
            Navigation.NavigateTo("/chat/group");
        else
            Navigation.NavigateTo("/chat/personal");
    }

    private void ShowAddMemberModal()
    {
        memberSearchQuery = string.Empty;
        memberSearchError = string.Empty;
        foundMember = null;
        hasSearchedMember = false;
        memberAddedMessage = null;
        isAddingMember = false;
        showAddMemberModal = true;
    }

    private void CloseAddMemberModal()
    {
        showAddMemberModal = false;
    }

    private async Task SearchMember()
    {
        if (string.IsNullOrWhiteSpace(memberSearchQuery)) return;

        isSearchingMember = true;
        memberSearchError = string.Empty;
        foundMember = null;
        hasSearchedMember = true;
        memberAddedMessage = null;
        StateHasChanged();

        try
        {
            foundMember = await Mediator.Send(new GetUserByEmailQuery { Email = memberSearchQuery.Trim() })
                        ?? await Mediator.Send(new GetUserByUserNameQuery { UserName = memberSearchQuery.Trim() });

            if (foundMember?.Id == currentUserId)
            {
                memberSearchError = "You cannot add yourself.";
                foundMember = null;
            }
        }
        catch (Exception ex)
        {
            memberSearchError = $"Search failed: {ex.Message}";
        }
        finally
        {
            isSearchingMember = false;
        }
    }

    private async Task AddMember(int userId)
    {
        if (isAddingMember) return;
        isAddingMember = true;
        memberAddedMessage = null;
        StateHasChanged();

        try
        {
            var success = await Mediator.Send(new AddUserToGroupCommand
            {
                GroupId = ChatId,
                UserId = userId,
                RequestedByUserId = currentUserId,
            });

            if (success)
            {
                memberAddedMessage = new MemberAddedMessage
                {
                    Text = "Member added successfully!",
                    IsSuccess = true,
                };
                foundMember = null;
                memberSearchQuery = string.Empty;
                statusText = $"{int.Parse(statusText.Split(' ')[0]) + 1} members";
            }
            else
            {
                memberAddedMessage = new MemberAddedMessage
                {
                    Text = "You don't have permission or user is already a member.",
                    IsSuccess = false,
                };
            }
        }
        catch (Exception ex)
        {
            memberAddedMessage = new MemberAddedMessage
            {
                Text = $"Error: {ex.Message}",
                IsSuccess = false,
            };
        }
        finally
        {
            isAddingMember = false;
        }
    }

    public void Dispose()
    {
        BroadcastService.OnPersonalMessageReceived -= HandlePersonalMessage;
        BroadcastService.OnGroupMessageReceived -= HandleGroupMessage;
        BroadcastService.OnMessageEdited -= HandleMessageEdited;
        BroadcastService.OnMessageDeleted -= HandleMessageDeleted;
        StatusBroadcast.OnUserStatusChanged -= HandleUserStatusChanged;
    }
}

