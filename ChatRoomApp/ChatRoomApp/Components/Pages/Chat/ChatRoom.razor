@page "/chat/personal/{ChatId:int}"
@page "/chat/group/{ChatId:int}"
@rendermode InteractiveServer
@using Application.PersonalChats.UseCases.Queries
@using Application.PersonalChats.UseCases.Commands
@using Application.GroupChats.UseCases.Queries
@using Application.GroupChats.UseCases.Commands
@using Application.Messages.UseCases.Dto
@using Application.Users.UseCases.Queries
@using Application.Users.UseCases.DTOs
@using ChatRoomApp.Services
@using MediatR
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR
@using Microsoft.JSInterop
@implements IDisposable
@inject IMediator Mediator
@inject IHubContext<Hubs.ChatHub> HubContext
@inject MessageBroadcastService BroadcastService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject UserStatusBroadcastService StatusBroadcast

<div class="chat-room d-flex flex-column">
    <div class="chat-header d-flex align-items-center gap-3 px-4 py-3">
        <button class="btn-back" @onclick="GoBack" type="button" title="Back">
            <i class="fas fa-arrow-left"></i>
        </button>
        <div class="chat-header-info flex-grow-1">
            <h5 class="m-0">@chatName</h5>
            <small class="text-secondary">@statusText</small>
        </div>
        @if (isGroupChat)
        {
            <button class="btn btn-sm btn-outline-light" @onclick="ShowAddMemberModal" title="Add Member">
                <i class="fas fa-user-plus"></i>
            </button>
        }
    </div>

    <div class="messages-area flex-grow-1 px-4 py-3" @ref="messagesContainer">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (!messages.Any())
        {
            <div class="empty-state text-center py-5">
                <i class="fas fa-comment-slash fa-3x text-secondary mb-3"></i>
                <p class="text-secondary">No messages yet. Say hello!</p>
            </div>
        }
        else
        {
            @foreach (var msg in messages)
            {
                var isMine = msg.SenderId == currentUserId;
                <div class="message @(isMine ? "mine" : "theirs")">
                    @if (!isMine && isGroupChat)
                    {
                        <small class="sender-name">@msg.SenderName</small>
                    }
                    <div class="bubble @(isMine ? "bubble-mine" : "bubble-theirs")">
                        @if (msg.ReplyToMessageId.HasValue)
                        {
                            <div class="reply-preview">Replying to a message</div>
                        }
                        <div class="msg-text">@msg.Text</div>
                        <div class="msg-meta d-flex align-items-center justify-content-end gap-1">
                            <span class="msg-time">@msg.SentTime.ToShortTimeString()</span>
                            @if (isMine)
                            {
                                @if (msg.IsSeen)
                                {
                                    <i class="fas fa-check-double text-info" style="font-size:0.65rem"></i>
                                }
                                else if (msg.IsDelivered)
                                {
                                    <i class="fas fa-check-double text-secondary" style="font-size:0.65rem"></i>
                                }
                                else
                                {
                                    <i class="fas fa-check text-secondary" style="font-size:0.65rem"></i>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="message-input d-flex align-items-center gap-3 px-4 py-3">
        <textarea class="form-control"
                  rows="1"
                  placeholder="Type a message..."
                  @bind="messageText"
                  @onkeydown="HandleKeyDown"
                  disabled="@isLoading" />
        <button class="btn btn-primary send-btn"
                @onclick="SendMessage"
                disabled="@(string.IsNullOrWhiteSpace(messageText) || isSending)">
            <i class="fas fa-paper-plane"></i>
        </button>
    </div>
</div>

@if (showAddMemberModal)
{
    <div class="grp-modal-overlay" @onclick="CloseAddMemberModal">
        <div class="grp-modal-box" @onclick:stopPropagation="true">
            <div class="grp-modal-head">
                <h5 class="grp-modal-title"><i class="fas fa-user-plus me-2"></i>Add Member</h5>
                <button type="button" class="btn-close" @onclick="CloseAddMemberModal">×</button>
            </div>
            <div class="grp-modal-body">
                <div class="mb-3">
                    <label for="memberSearch" class="form-label">Search by username or email</label>
                    <div class="input-group">
                        <input id="memberSearch" type="text" class="form-control"
                               placeholder="Type to search..."
                               @bind="memberSearchQuery" @bind:event="oninput" />
                        <button class="btn btn-primary" @onclick="SearchMember"
                                disabled="@(string.IsNullOrWhiteSpace(memberSearchQuery) || isSearchingMember)">
                            @if (isSearchingMember)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <i class="fas fa-search"></i>
                            }
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(memberSearchError))
                {
                    <div class="alert alert-danger py-2">@memberSearchError</div>
                }

                @if (foundMember is not null)
                {
                    <div class="user-card">
                        <div class="user-avatar">@(foundMember.FullName.Length > 0 ? foundMember.FullName[0].ToString().ToUpper() : "?")</div>
                        <div class="user-info">
                            <strong>@foundMember.FullName</strong>
                            <small class="text-secondary">@@@foundMember.UserName</small>
                        </div>
                        @if (isAddingMember)
                        {
                            <span class="spinner-border spinner-border-sm text-success"></span>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => AddMember(foundMember.Id)">
                                <i class="fas fa-plus"></i> Add
                            </button>
                        }
                    </div>
                }

                @if (hasSearchedMember && foundMember is null && string.IsNullOrEmpty(memberSearchError))
                {
                    <div class="empty-state text-center py-3">
                        <i class="fas fa-user-slash fa-2x text-secondary mb-2"></i>
                        <p class="text-secondary mb-0">No user found.</p>
                    </div>
                }

                @if (memberAddedMessage != null)
                {
                    <div class="alert alert-@(memberAddedMessage.IsSuccess ? "success" : "danger") py-2 mt-2">
                        @memberAddedMessage.Text
                    </div>
                }
            </div>
            <div class="grp-modal-foot">
                <button type="button" class="btn btn-secondary" @onclick="CloseAddMemberModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int ChatId { get; set; }

    private List<MessageDto> messages = new();
    private string messageText = string.Empty;
    private string chatName = "Loading...";
    private string statusText = string.Empty;
    private bool isLoading = true;
    private bool isSending;
    private bool isGroupChat;
    private int currentUserId;
    private int otherUserId;
    private Dictionary<int, string> senderNames = new();
    private ElementReference messagesContainer;

    private bool showAddMemberModal;
    private string memberSearchQuery = string.Empty;
    private bool isSearchingMember;
    private bool hasSearchedMember;
    private string memberSearchError = string.Empty;
    private UserDto? foundMember;
    private bool isAddingMember;
    private MemberAddedMessage? memberAddedMessage;

    private class MemberAddedMessage
    {
        public string Text { get; set; } = string.Empty;
        public bool IsSuccess { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await GetCurrentUserId();
        if (currentUserId == 0) { Navigation.NavigateTo("/account/login"); return; }

        var uri = new Uri(Navigation.Uri);
        isGroupChat = uri.AbsolutePath.StartsWith("/chat/group", StringComparison.OrdinalIgnoreCase);

        BroadcastService.OnPersonalMessageReceived += HandlePersonalMessage;
        BroadcastService.OnGroupMessageReceived += HandleGroupMessage;
        StatusBroadcast.OnUserStatusChanged += HandleUserStatusChanged;

        await LoadChat();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await ScrollToBottom();
    }

    private async Task GetCurrentUserId()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            currentUserId = userId;
        }
    }

    private async Task LoadChat()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (isGroupChat)
            {
                var group = await Mediator.Send(new GetGroupChatByIdQuery { GroupId = ChatId });
                if (group is null) { Navigation.NavigateTo("/chat"); return; }

                chatName = group.Name;
                statusText = $"{group.Members.Count} members";
                messages = group.Messages.OrderBy(m => m.SentTime).ToList();

                foreach (var member in group.Members)
                {
                    var user = await Mediator.Send(new GetUserByIdQuery { UserId = member.UserId });
                    if (user != null)
                        senderNames[member.UserId] = user.FullName ?? user.UserName ?? "Unknown";
                }
            }
            else
            {
                var chat = await Mediator.Send(new GetPersonalChatByIdQuery { PersonalId = ChatId });
                if (chat is null) { Navigation.NavigateTo("/chat"); return; }

                otherUserId = chat.UserOneId == currentUserId ? chat.UserTwoId : chat.UserOneId;
                var user = await Mediator.Send(new GetUserByIdQuery { UserId = otherUserId });
                chatName = user?.FullName ?? user?.UserName ?? "Unknown";
                statusText = user?.IsOnline == true ? "Online" : "Offline";
                messages = chat.Messages.OrderBy(m => m.SentTime).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading chat: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(messageText) || isSending) return;

        var text = messageText;
        messageText = string.Empty;
        isSending = true;
        StateHasChanged();

        try
        {
            if (isGroupChat)
            {
                var msg = await Mediator.Send(new SendMessageToGroupCommand
                {
                    GroupId = ChatId,
                    SenderId = currentUserId,
                    Text = text,
                });

                if (msg != null)
                {
                    messages.Add(msg);
                    await HubContext.Clients.Group(ChatId.ToString())
                        .SendAsync("ReceiveGroupMessage", msg);
                    BroadcastService.NotifyGroupMessage(msg);
                    StateHasChanged();
                }
            }
            else
            {
                var msg = await Mediator.Send(new SendPersonalMessageCommand
                {
                    SenderId = currentUserId,
                    ReceiverId = otherUserId,
                    PersonalChatId = ChatId,
                    Text = text,
                });

                if (msg != null)
                {
                    messages.Add(msg);
                    await HubContext.Clients.User(otherUserId.ToString())
                        .SendAsync("ReceivePersonalMessage", msg);
                    BroadcastService.NotifyPersonalMessage(msg);
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Send failed: {ex.Message}");
        }
        finally
        {
            isSending = false;
        }
    }

    private void HandlePersonalMessage(MessageDto msg)
    {
        if (!isGroupChat && msg.PersonalChatId == ChatId && msg.SenderId != currentUserId)
        {
            messages.Add(msg);
            InvokeAsync(StateHasChanged);
            InvokeAsync(ScrollToBottom);
        }
    }

    private void HandleGroupMessage(MessageDto msg)
    {
        if (isGroupChat && msg.GroupChatId == ChatId && msg.SenderId != currentUserId)
        {
            if (!senderNames.ContainsKey(msg.SenderId))
            {
                _ = LoadSenderNameAsync(msg.SenderId);
            }
            messages.Add(msg);
            InvokeAsync(StateHasChanged);
            InvokeAsync(ScrollToBottom);
        }
    }

    private void HandleUserStatusChanged(int userId, bool isOnline)
    {
        if (!isGroupChat && userId == otherUserId)
        {
            statusText = isOnline ? "Online" : "Offline";
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadSenderNameAsync(int userId)
    {
        try
        {
            var user = await Mediator.Send(new GetUserByIdQuery { UserId = userId });
            if (user != null)
            {
                senderNames[userId] = user.FullName ?? user.UserName ?? "Unknown";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    private string GetSenderName(int userId)
    {
        return senderNames.TryGetValue(userId, out var name) ? name : "Unknown";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "document.querySelector('.messages-area')?.scrollTo(0, document.querySelector('.messages-area')?.scrollHeight)");
        }
        catch { }
    }

    private void GoBack()
    {
        if (isGroupChat)
            Navigation.NavigateTo("/chat/group");
        else
            Navigation.NavigateTo("/chat/personal");
    }

    private void ShowAddMemberModal()
    {
        memberSearchQuery = string.Empty;
        memberSearchError = string.Empty;
        foundMember = null;
        hasSearchedMember = false;
        memberAddedMessage = null;
        isAddingMember = false;
        showAddMemberModal = true;
    }

    private void CloseAddMemberModal()
    {
        showAddMemberModal = false;
    }

    private async Task SearchMember()
    {
        if (string.IsNullOrWhiteSpace(memberSearchQuery)) return;

        isSearchingMember = true;
        memberSearchError = string.Empty;
        foundMember = null;
        hasSearchedMember = true;
        memberAddedMessage = null;
        StateHasChanged();

        try
        {
            foundMember = await Mediator.Send(new GetUserByEmailQuery { Email = memberSearchQuery.Trim() })
                        ?? await Mediator.Send(new GetUserByUserNameQuery { UserName = memberSearchQuery.Trim() });

            if (foundMember?.Id == currentUserId)
            {
                memberSearchError = "You cannot add yourself.";
                foundMember = null;
            }
        }
        catch (Exception ex)
        {
            memberSearchError = $"Search failed: {ex.Message}";
        }
        finally
        {
            isSearchingMember = false;
        }
    }

    private async Task AddMember(int userId)
    {
        if (isAddingMember) return;
        isAddingMember = true;
        memberAddedMessage = null;
        StateHasChanged();

        try
        {
            var success = await Mediator.Send(new AddUserToGroupCommand
            {
                GroupId = ChatId,
                UserId = userId,
            });

            if (success)
            {
                memberAddedMessage = new MemberAddedMessage
                {
                    Text = "Member added successfully!",
                    IsSuccess = true,
                };
                foundMember = null;
                memberSearchQuery = string.Empty;
                statusText = $"{int.Parse(statusText.Split(' ')[0]) + 1} members";
            }
            else
            {
                memberAddedMessage = new MemberAddedMessage
                {
                    Text = "User is already a member or not found.",
                    IsSuccess = false,
                };
            }
        }
        catch (Exception ex)
        {
            memberAddedMessage = new MemberAddedMessage
            {
                Text = $"Error: {ex.Message}",
                IsSuccess = false,
            };
        }
        finally
        {
            isAddingMember = false;
        }
    }

    public void Dispose()
    {
        BroadcastService.OnPersonalMessageReceived -= HandlePersonalMessage;
        BroadcastService.OnGroupMessageReceived -= HandleGroupMessage;
        StatusBroadcast.OnUserStatusChanged -= HandleUserStatusChanged;
    }
}

<style>
    .chat-room {
        height: calc(100vh - 60px);
        background: #1a1a2e;
    }

    .chat-header {
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        background: #16213e;
        flex-shrink: 0;
    }

    .chat-header h5 {
        color: #fff;
    }

    .btn-back {
        background: none;
        border: none;
        color: #adb5bd;
        font-size: 1.2rem;
        padding: 8px 12px;
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-back:hover {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
    }

    .messages-area {
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 1rem;
    }

    .message {
        display: flex;
        flex-direction: column;
        max-width: 75%;
    }

    .message.mine {
        align-self: flex-end;
    }

    .message.theirs {
        align-self: flex-start;
    }

    .sender-name {
        font-size: 0.75rem;
        color: #0d6efd;
        margin-bottom: 2px;
        margin-left: 4px;
    }

    .bubble {
        padding: 0.5rem 0.875rem;
        border-radius: 18px;
        position: relative;
        word-wrap: break-word;
    }

    .bubble-mine {
        background: #0d6efd;
        color: #fff;
        border-bottom-right-radius: 4px;
    }

    .bubble-theirs {
        background: rgba(255, 255, 255, 0.08);
        color: #e0e0e0;
        border-bottom-left-radius: 4px;
    }

    .reply-preview {
        font-size: 0.75rem;
        opacity: 0.7;
        padding: 2px 0 4px;
        border-left: 2px solid currentColor;
        padding-left: 6px;
        margin-bottom: 4px;
    }

    .msg-meta {
        margin-top: 2px;
    }

    .msg-time {
        font-size: 0.65rem;
        opacity: 0.7;
    }

    .message-input {
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        background: #16213e;
        flex-shrink: 0;
    }

    .message-input textarea {
        resize: none;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #e0e0e0;
        border-radius: 24px;
        padding: 0.6rem 1rem;
        flex: 1;
        max-height: 120px;
    }

    .message-input textarea:focus {
        border-color: #0d6efd;
        box-shadow: none;
    }

    .message-input textarea::placeholder {
        color: #6c757d;
    }

    .send-btn {
        border-radius: 50%;
        width: 44px;
        height: 44px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* Add Member Modal */
    .grp-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }

    .grp-modal-box {
        background: #fff;
        border-radius: 12px;
        width: 90%;
        max-width: 440px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.2);
        overflow: hidden;
        pointer-events: auto;
    }

    .grp-modal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #dee2e6;
    }

    .grp-modal-title {
        margin: 0;
        font-size: 1.15rem;
        color: #212529;
    }

    .grp-modal-body {
        padding: 1.25rem;
    }

    .grp-modal-foot {
        display: flex;
        justify-content: flex-end;
        padding: 1rem 1.25rem;
        border-top: 1px solid #dee2e6;
    }

    .user-card {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        background: #f8f9fa;
        border-radius: 10px;
        margin-top: 0.5rem;
    }

    .user-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .user-info {
        flex: 1;
        color: #212529;
    }

    .user-info strong {
        display: block;
    }

    @@media (max-width: 768px) {
        .chat-room {
            height: calc(100vh - 50px);
        }

        .message {
            max-width: 85%;
        }
    }
</style>
