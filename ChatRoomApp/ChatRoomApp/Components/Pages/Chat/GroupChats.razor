@page "/chat/group"
@rendermode InteractiveServer
@using Application.Users.UseCases.Queries
@using ChatRoomApp.ViewModels.Chat
@using Application.GroupChats.UseCases.Commands
@using MediatR
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<h3>Group Chats</h3>
@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (chats == null || !chats.Any())
{
    <div class="alert alert-info">
        No chats found. Start a new conversation!
    </div>
}
else
{
    <div class="chat-list">
        @foreach (var chat in chats)
        {
            <div class="chat-item group-chat"
                 @onclick="() => OpenChat(chat)">
                <div class="chat-info">
                    <div class="chat-header">
                        <h5 class="chat-name">
                                <i class="fas fa-users"></i>
                            @chat.Name
                        </h5>
                        <small class="chat-time">@FormatTime(chat.LastMessageTime)</small>
                    </div>

                    @if (!string.IsNullOrEmpty(chat.Description))
                    {
                        <div class="chat-description">@chat.Description</div>
                    }

                    <div class="chat-last-message">
                        <span class="last-message-text">
                            @(string.IsNullOrEmpty(chat.LastMessageText) ? "No messages yet" : chat.LastMessageText)
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
}

<button class="fab-new-chat" title="New Chat" @onclick="ShowCreateModal" type="button">
    <i class="fas fa-plus"></i>
</button>

@if (showCreateModal)
{
    <div class="group-modal-overlay" @onclick="CloseCreateModal">
        <div class="group-modal-box" @onclick:stopPropagation="true">
            <div class="group-modal-head">
                <h5 class="group-modal-title"><i class="fas fa-users me-2"></i>Create New Group</h5>
                <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
            </div>
            <div class="group-modal-body">
                <div class="mb-3">
                    <label for="groupName" class="form-label">Group Name <span class="text-danger">*</span></label>
                    <input id="groupName" type="text" class="form-control" placeholder="Enter group name..."
                           @bind="newGroupName" @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label for="groupDescription" class="form-label">Description</label>
                    <textarea id="groupDescription" class="form-control" rows="3"
                              placeholder="Optional description..." @bind="newGroupDescription"></textarea>
                </div>
                <div class="mb-3 form-check form-switch">
                    <input id="isPublic" class="form-check-input" type="checkbox" @bind="newGroupIsPublic" />
                    <label for="isPublic" class="form-check-label">Public group</label>
                </div>
                @if (!string.IsNullOrEmpty(createError))
                {
                    <div class="alert alert-danger py-2">@createError</div>
                }
            </div>
            <div class="group-modal-foot">
                <button type="button" class="btn btn-secondary" @onclick="CloseCreateModal">Cancel</button>
                <button type="button" class="btn btn-success" @onclick="CreateGroup" disabled="@(string.IsNullOrWhiteSpace(newGroupName) || isCreating)">
                    @if (isCreating)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="fas fa-plus me-1"></i>Create
                </button>
            </div>
        </div>
    </div>
}

@code {

    List<ChatListViewModel> chats = new List<ChatListViewModel>();
    bool isLoading = true;
    private int currentUserId = 0;
    int userRole = 0;


    bool showCreateModal = false;
    string newGroupName = string.Empty;
    string newGroupDescription = string.Empty;
    bool newGroupIsPublic = true;
    bool isCreating = false;
    string createError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await GetCurrentUserId();
        await LoadChats();
    }

    private async Task GetCurrentUserId()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);

        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            currentUserId = userId;
        }
    }

    private async Task LoadChats()
    {
        try
        {
            isLoading = true;
            chats = await ChatListViewModel.GetGroupChatsByUserIdAsync(currentUserId, Mediator);

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading chats: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenChat(ChatListViewModel chat)
    {
        Navigation.NavigateTo($"/chat/group/{chat.Id}");
    }

    private void ShowCreateModal()
    {
        newGroupName = string.Empty;
        newGroupDescription = string.Empty;
        newGroupIsPublic = true;
        createError = string.Empty;
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
    }

    private async Task CreateGroup()
    {
        if (string.IsNullOrWhiteSpace(newGroupName)) return;

        isCreating = true;
        createError = string.Empty;

        try
        {
            var command = new CreateGroupChatCommand
            {
                Name = newGroupName.Trim(),
                Description = string.IsNullOrWhiteSpace(newGroupDescription) ? null : newGroupDescription.Trim(),
                OwnerId = currentUserId,
                IsPublic = newGroupIsPublic,
            };

            var group = await Mediator.Send(command);
            if (group is not null)
            {
                showCreateModal = false;
                Navigation.NavigateTo($"/chat/group/{group.Id}");
            }
            else
            {
                createError = "Failed to create group.";
            }
        }
        catch (Exception ex)
        {
            createError = $"Error: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }

    private string FormatTime(DateTime time)
    {
        var now = DateTime.Now;
        var difference = now - time;

        if (difference.TotalMinutes < 1)
            return "Just now";
        if (difference.TotalHours < 1)
            return $"{(int)difference.TotalMinutes}m ago";
        if (difference.TotalDays < 1)
            return $"{(int)difference.TotalHours}h ago";
        if (difference.TotalDays < 7)
            return $"{(int)difference.TotalDays}d ago";

        return time.ToString("MMM dd");
    }

}

<style>
    .chat-list {
        max-width: 600px;
        margin: 0 auto;
    }

    .chat-item {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .chat-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

    .chat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 5px;
    }

    .chat-name {
        margin: 0;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .chat-name i {
            color: #6c757d;
        }

    .chat-time {
        color: #6c757d;
        font-size: 0.8rem;
    }

    .chat-description {
        color: #6c757d;
        font-size: 0.85rem;
        margin-bottom: 8px;
    }

    .chat-last-message {
        margin-top: 8px;
        padding-top: 8px;
        border-top: 1px solid #e9ecef;
    }

    .last-message-text {
        color: #495057;
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    .personal-chat .chat-name i {
        color: #0d6efd;
    }

    .group-chat .chat-name i {
        color: #198754;
    }

    /* Floating Action Button */
    .fab-new-chat {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background-color: #0d6efd;
        color: white;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        z-index: 1000;
    }

        .fab-new-chat:hover {
            background-color: #0b5ed7;
            transform: scale(1.1);
            box-shadow: 0 6px 16px rgba(13, 110, 253, 0.5);
        }

        .fab-new-chat:active {
            transform: scale(0.95);
        }

    /* Modal */
    .group-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }

    .group-modal-box {
        background: #fff;
        border-radius: 12px;
        width: 90%;
        max-width: 480px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.2);
        overflow: hidden;
        pointer-events: auto;
    }

    .group-modal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #dee2e6;
    }

    .group-modal-title {
        margin: 0;
        font-size: 1.15rem;
    }

    .btn-close {
        background: none;
        border: none;
        font-size: 1.25rem;
        cursor: pointer;
        opacity: 0.5;
        padding: 0;
        line-height: 1;
    }

    .btn-close:hover {
        opacity: 0.75;
    }

    .group-modal-body {
        padding: 1.25rem;
    }

    .group-modal-foot {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        padding: 1rem 1.25rem;
        border-top: 1px solid #dee2e6;
    }

    /* Mobile responsive */
    @@media (max-width: 768px) {
        .chat-list {
            max-width: 100%;
            margin: 0;
        }

        .chat-item {
            border-radius: 0;
            margin-bottom: 1px;
        }

        .fab-new-chat {
            bottom: 20px;
            right: 20px;
            width: 56px;
            height: 56px;
        }
    }
</style>
