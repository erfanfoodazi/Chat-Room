@page "/chat"
@rendermode InteractiveServer
@using ChatRoomApp.ViewModels.Chat
@using ChatRoomApp.Services
@using MediatR
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserStatusBroadcastService StatusBroadcast

<h3>My Chats</h3>
@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (chats == null || !chats.Any())
{
    <div class="alert alert-info">
        No chats found. Start a new conversation!
    </div>
}
else
{
    <div class="chat-list">
        @foreach (var chat in chats)
        {
            <div class="chat-item @(chat.ChatType == "Group" ? "group-chat" : "personal-chat")"
                 @onclick="() => OpenChat(chat)">
                <div class="chat-info">
                    <div class="chat-header">
                        <h5 class="chat-name">
                            @if (chat.ChatType == "Group")
                            {
                                <i class="fas fa-users"></i>
                            }
                            else
                            {
                                <i class="fas fa-user"></i>
                            }
                            @chat.Name
                            @if (chat.ChatType == "Personal" && chat.IsOnline)
                            {
                                <span class="online-badge"></span>
                            }
                        </h5>
                        <small class="chat-time">@FormatTime(chat.LastMessageTime)</small>
                    </div>

                    @if (!string.IsNullOrEmpty(chat.Description))
                    {
                        <div class="chat-description">@chat.Description</div>
                    }

                    <div class="chat-last-message">
                        <span class="last-message-text">
                            @(string.IsNullOrEmpty(chat.LastMessageText) ? "No messages yet" : chat.LastMessageText)
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
}

<button class="fab-new-chat" title="New Chat" @onclick="StartNewChat" type="button">
    <i class="fas fa-plus"></i>
</button>

@code {

    List<ChatListViewModel> chats = new List<ChatListViewModel>();
    bool isLoading = true;
    private int currentUserId = 0;

    protected override async Task OnInitializedAsync()
    {
        await GetCurrentUserId();
        StatusBroadcast.OnUserStatusChanged += HandleUserStatusChanged;
        await LoadChats();
    }

    private void HandleUserStatusChanged(int userId, bool isOnline)
    {
        var chat = chats.FirstOrDefault(c => c.ChatType == "Personal" && c.OtherUserId == userId);
        if (chat is not null)
        {
            chat.IsOnline = isOnline;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        StatusBroadcast.OnUserStatusChanged -= HandleUserStatusChanged;
    }

    private async Task GetCurrentUserId()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);

        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            currentUserId = userId;
        }
    }

    private async Task LoadChats()
    {
        try
        {
            isLoading = true;
            chats = await ChatListViewModel.GetAllChatsByUserIdAsync(currentUserId, Mediator);
           
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading chats: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenChat(ChatListViewModel chat)
    {
        if (chat.ChatType == "Personal")
        {
            Navigation.NavigateTo($"/chat/personal/{chat.Id}");
        }
        else
        {
            Navigation.NavigateTo($"/chat/group/{chat.Id}");
        }
    }

    private void StartNewChat()
    {

        Console.WriteLine("go to new chat page");
        Navigation.NavigateTo("/chat/new");
    }

    private string FormatTime(DateTime time)
    {
        var now = DateTime.UtcNow;
        var difference = now - time;

        if (difference.TotalMinutes < 1)
            return "Just now";
        if (difference.TotalHours < 1)
            return $"{(int)difference.TotalMinutes}m ago";
        if (difference.TotalDays < 1)
            return $"{(int)difference.TotalHours}h ago";
        if (difference.TotalDays < 7)
            return $"{(int)difference.TotalDays}d ago";

        return time.ToString("MMM dd");
    }
}

<style>
    .chat-list {
        max-width: 600px;
        margin: 0 auto;
    }

    .chat-item {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .chat-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

    .chat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 5px;
    }

    .chat-name {
        margin: 0;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .online-badge {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #198754;
        flex-shrink: 0;
    }

        .chat-name i {
            color: #6c757d;
        }

    .chat-time {
        color: #6c757d;
        font-size: 0.8rem;
    }

    .chat-description {
        color: #6c757d;
        font-size: 0.85rem;
        margin-bottom: 8px;
    }

    .chat-last-message {
        margin-top: 8px;
        padding-top: 8px;
        border-top: 1px solid #e9ecef;
    }

    .last-message-text {
        color: #495057;
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    .personal-chat .chat-name i {
        color: #0d6efd;
    }

    .group-chat .chat-name i {
        color: #198754;
    }

    /* Floating Action Button */
    .fab-new-chat {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background-color: #0d6efd;
        color: white;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        z-index: 1000;
    }

        .fab-new-chat:hover {
            background-color: #0b5ed7;
            transform: scale(1.1);
            box-shadow: 0 6px 16px rgba(13, 110, 253, 0.5);
        }

        .fab-new-chat:active {
            transform: scale(0.95);
        }

    /* Mobile responsive */
    @@media (max-width: 768px) {
        .chat-list {
            max-width: 100%;
            margin: 0;
        }

        .chat-item {
            border-radius: 0;
            margin-bottom: 1px;
        }

        .fab-new-chat {
            bottom: 20px;
            right: 20px;
            width: 56px;
            height: 56px;
        }
    }
</style>
