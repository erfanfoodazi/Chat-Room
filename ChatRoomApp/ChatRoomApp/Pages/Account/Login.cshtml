@page
@model ChatRoomApp.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — ChatRoom</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #212529;
            font-family: 'Segoe UI', sans-serif;
        }

        .form-control {
            background-color: #000 !important;
            border-color: #495057 !important;
            color: #fff !important;
        }

            .form-control::placeholder {
                color: #6c757d;
            }

            .form-control:focus {
                border-color: #0d6efd !important;
                box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15) !important;
            }

        .btn-primary {
            transition: opacity 0.2s;
        }

            .btn-primary:hover {
                opacity: 0.9;
            }

        .card {
            border-color: #495057 !important;
        }
    </style>
</head>
<body>

    <div class="min-vh-100 d-flex align-items-center justify-content-center bg-dark">
        <div class="card border-secondary shadow-lg" style="width: 100%; max-width: 460px;">
            <div class="card-body p-4 p-md-5 bg-dark text-white rounded">

                <span class="badge bg-primary bg-opacity-25 text-primary mb-3">Welcome Back</span>
                <h2 class="fw-bold mb-1">Sign in to ChatRoom</h2>
                <p class="text-secondary mb-4">Enter your credentials to continue.</p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger py-2">⚠ @Model.ErrorMessage</div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label text-secondary small text-uppercase fw-semibold">Username</label>
                        <input type="text" class="form-control bg-black border-secondary text-white"
                               asp-for="Email" placeholder="johndoe" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-secondary small text-uppercase fw-semibold">Password</label>
                        <input type="password" class="form-control bg-black border-secondary text-white"
                               asp-for="Password" placeholder="Your password" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        Sign In →
                    </button>
                </form>

                <p class="text-center text-secondary mt-3 mb-0 small">
                    Don't have an account?
                    <a href="/account/register" class="text-primary text-decoration-none fw-semibold">Create one</a>
                </p>

            </div>
        </div>
    </div>

</body>
</html>