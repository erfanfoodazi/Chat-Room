@page "/app/profile"
@layout ClientLayout
@rendermode InteractiveWebAssembly
@using System.Security.Claims
@inject ChatApiClient Api
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth

<div class="profile-page">
    <div class="page-header">
        <h4><i class="fas fa-user me-2"></i>My Profile</h4>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (user is not null)
    {
        <div class="profile-card">
            <div class="avatar-large">@(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "?")</div>
            <h4 class="mt-3 mb-1">@user.FullName</h4>
            <p class="text-secondary">@@@user.UserName</p>

            <div class="info-list">
                <div class="info-item">
                    <span class="info-label">Email</span>
                    <span class="info-value">@user.Email</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Bio</span>
                    <span class="info-value">@(string.IsNullOrEmpty(user.Bio) ? "No bio yet" : user.Bio)</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Joined</span>
                    <span class="info-value">@user.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private UserDto? user;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await Auth.GetAuthenticationStateAsync();
            if (!state.User.Identity?.IsAuthenticated ?? true)
            {
                Nav.NavigateTo("/account/login", true);
                return;
            }
            user = await Api.GetCurrentUserAsync();
        }
        finally
        {
            isLoading = false;
        }
    }
}

<style>
    .profile-page { padding: 2rem 1.5rem; max-width: 500px; margin: 0 auto; width: 100%; }
    .page-header { margin-bottom: 2rem; }
    .page-header h4 { color: #fff; margin: 0; }
    .profile-card { text-align: center; }
    .avatar-large {
        width: 96px; height: 96px; border-radius: 50%; margin: 0 auto;
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 2.5rem; font-weight: 700;
    }
    .info-list { margin-top: 2rem; text-align: left; }
    .info-item {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.875rem 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .info-label { color: #6c757d; font-size: 0.875rem; }
    .info-value { color: #e0e0e0; font-weight: 500; }
</style>
